        <mxCell id="DnfoZgHIZ2ViauFbOWgv-55" parent="DnfoZgHIZ2ViauFbOWgv-54" style="align=left;strokeColor=#6c8ebf;fillColor=#dae8fc;spacingLeft=4;spacingRight=4;fontSize=12;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;whiteSpace=wrap;gradientColor=#7ea6e0;" value="&lt;p class=&quot;MsoNormal&quot;&gt;* SubmissionID (Primary Key) — Unique identifier for a&lt;br&gt;specific upload.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;* StudentID (Foreign Key) — Links to the student who&lt;br&gt;submitted it.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;* AssignmentID (Foreign Key) — Links to the task being&lt;br&gt;answered/Status of Task.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;* AssessorID (Foreign Key, Nullable) — Links to the assessor&lt;br&gt;assigned to grade it.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;* SubmissionDate — Date and time uploaded.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;* Grade — Final score achieved.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;* Feedback — Written review from the assessor.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="260" width="350" y="50" as="geometry" />
        </mxCell>
