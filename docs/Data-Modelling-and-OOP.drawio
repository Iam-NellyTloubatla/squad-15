        <mxCell id="DnfoZgHIZ2ViauFbOWgv-53" parent="DnfoZgHIZ2ViauFbOWgv-52" style="align=left;strokeColor=#6c8ebf;fillColor=#dae8fc;spacingLeft=4;spacingRight=4;fontSize=12;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;whiteSpace=wrap;gradientColor=#7ea6e0;" value="&lt;p class=&quot;MsoNormal&quot;&gt;* AssignmentID (Primary Key) — Unique identifier for the&lt;br&gt;work to be graded.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;* Title — Name of the assignment.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;* DueDate — Deadline for submission.&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;*Status -- Completed or not completed&lt;/span&gt;&lt;/p&gt;" vertex="1">
