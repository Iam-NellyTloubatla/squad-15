        <mxCell id="DnfoZgHIZ2ViauFbOWgv-46" parent="DnfoZgHIZ2ViauFbOWgv-45" style="align=left;strokeColor=#6c8ebf;fillColor=#dae8fc;spacingLeft=4;spacingRight=4;fontSize=12;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;whiteSpace=wrap;gradientColor=#7ea6e0;" value="&lt;p class=&quot;MsoNormal&quot;&gt;* LeanerID (Primary Key) — Unique identifier for the&lt;br&gt;student.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;* FirstName — First name of the student.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;* LastName — Last name of the student.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;* Email — Unique email address.&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;* EnrollmentDate — Date the student joined the program.&lt;/span&gt;&lt;/p&gt;&lt;p class=&quot;MsoNormal&quot;&gt;* GradeLevel -- the leaner class level&lt;/p&gt;" vertex="1">
